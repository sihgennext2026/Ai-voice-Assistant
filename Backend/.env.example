# Copy to .env and fill in. Only NEXT_PUBLIC_* values are ever exposed to the browser.
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM (OpenRouter primary, Gemini fallback)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-plus-2025-07-28
GEMINI_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Speech
ASR_PROVIDER=whisper
# faster-whisper name or HF URL. On CPU: distil-small.en ~1.2s/utterance, large-v3 ~6-7s/utterance.
WHISPER_MODEL=distil-small.en
HF_TOKEN=
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Location (optional; demo uses a cached snapshot)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OPENROUTESERVICE_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Demo
DEMO_MODE=true
DEMO_CASE_ID=demo-tailoring-001
LOG_LEVEL=INFO
